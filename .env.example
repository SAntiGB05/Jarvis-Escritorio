# Todo esto se puede cambiar desde la ventana de ajustes de Jarvis.app.

# Identidad
JARVIS_NAME=Jarvis
JARVIS_WAKE_WORD=Raphael
JARVIS_PERSONA=britanico      # britanico | cercano | formal
USER_NAME=

# Voz (gratis, Microsoft Edge). Otras: es-ES-AlvaroNeural, es-MX-JorgeNeural
EDGE_VOICE=es-CO-GonzaloNeural
EDGE_RATE=+5%
EDGE_PITCH=-4Hz

# Cerebro: Claude Code con tu suscripción (sin API key)
JARVIS_BRAIN_MODEL=haiku

# Oído local
JARVIS_WHISPER_MODEL=small
JARVIS_LANGUAGE=es
# JARVIS_WAKE_SENS=2.5   # más bajo = más sensible a "Raphael"

# Ubicación fija para el clima
WEATHER_LOCATION_LABEL=Armenia, Quindío
WEATHER_LATITUDE=4.5339
WEATHER_LONGITUDE=-75.6811

# Spotify (para que reproduzca solo)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
